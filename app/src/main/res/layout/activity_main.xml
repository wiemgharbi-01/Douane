<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_main_wg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/ll_main_container_wg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- En-tête : Titre et sous-titre de l'application -->
        <TextView
            android:id="@+id/tv_titre_wg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/titre_formulaire"
            android:textColor="@color/primary_color"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sous_titre_wg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/sous_titre_formulaire"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Carte contenant le formulaire -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_form_wg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/ll_form_content_wg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Section Photo du voyageur -->
                <LinearLayout
                    android:id="@+id/ll_photo_section_wg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_photo_preview_wg"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/border_color"
                        app:strokeWidth="1.5dp">

                        <ImageView
                            android:id="@+id/iv_photo_preview_wg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Photo du voyageur"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_passport_avatar" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_choisir_photo_wg"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_choisir_photo"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_color"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/primary_color"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Champ 1 : Nom du voyageur -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_nom_wg"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/label_nom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_nom_wg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Champ 2 : Année de naissance -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_annee_naissance_wg"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/label_annee_naissance">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_annee_naissance_wg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Champ 3 : Année de destination -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_annee_destination_wg"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:hint="@string/label_annee_destination">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_annee_destination_wg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Champ 4 : Motif du voyage -->
                <TextView
                    android:id="@+id/tv_motif_label_wg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/label_motif"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_motif_wg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_tourisme_wg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:paddingVertical="4dp"
                        android:text="@string/motif_tourisme"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_modification_wg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:text="@string/motif_modification"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_fuite_wg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:text="@string/motif_fuite"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bouton d'action pour inspecter le profil -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_inspecter_wg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/primary_color"
            android:text="@string/btn_inspecter"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:iconGravity="textStart" />

    </LinearLayout>
</ScrollView>
