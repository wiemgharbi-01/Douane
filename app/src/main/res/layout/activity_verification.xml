<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_root_verification_wg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_passport_ticket"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="16dp"
    tools:context=".VerificationActivity">

    <!-- Partie GAUCHE : Image avec poids 0.3 obligatoire -->
    <ImageView
        android:id="@+id/iv_photo_passeport_wg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:contentDescription="Photo officielle du passeport temporel"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_passport_avatar" />

    <!-- Partie DROITE : RelativeLayout avec poids 0.7 obligatoire -->
    <RelativeLayout
        android:id="@+id/rl_passeport_content_wg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <!-- En-tête passeport -->
        <TextView
            android:id="@+id/tv_titre_passeport_wg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:letterSpacing="0.08"
            android:text="@string/titre_passeport"
            android:textColor="@color/passport_header"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sous_titre_passeport_wg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_titre_passeport_wg"
            android:layout_marginTop="2dp"
            android:text="@string/sous_titre_passeport"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Ligne de séparation stylisée -->
        <View
            android:id="@+id/v_separator_wg"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/tv_sous_titre_passeport_wg"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/passport_border" />

        <!-- Champ 1 : Nom du voyageur -->
        <TextView
            android:id="@+id/tv_nom_label_wg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/v_separator_wg"
            android:text="@string/label_nom_pass"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_nom_valeur_wg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_nom_label_wg"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Marty McFly" />

        <!-- Champ 2 : Âge temporel calculé -->
        <TextView
            android:id="@+id/tv_age_label_wg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_nom_valeur_wg"
            android:text="@string/label_age_pass"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_age_valeur_wg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_age_label_wg"
            android:layout_marginBottom="8dp"
            android:textColor="@color/primary_color"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="82 ans (Saut vers 2050)" />

        <!-- Champ 3 : Motif du voyage -->
        <TextView
            android:id="@+id/tv_motif_label_wg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_age_valeur_wg"
            android:text="@string/label_motif_pass"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_motif_valeur_wg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_motif_label_wg"
            android:layout_marginBottom="10dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Modification du passé" />

        <!-- Message d'alerte en cas de paradoxe temporel -->
        <TextView
            android:id="@+id/tv_alerte_paradoxe_wg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_motif_valeur_wg"
            android:layout_marginBottom="10dp"
            android:background="#FEE2E2"
            android:padding="8dp"
            android:text="@string/alerte_paradoxe_texte"
            android:textColor="@color/paradox_warning"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Bouton 2 : Refuser (Risque de paradoxe) - en bas -->
        <Button
            android:id="@+id/btn_refuser_wg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:backgroundTint="@color/btn_refuser_bg"
            android:text="@string/btn_refuser"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Bouton 1 : Approuver le saut temporel - au dessus du bouton refuser -->
        <Button
            android:id="@+id/btn_approuver_wg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_above="@id/btn_refuser_wg"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/btn_approuver_bg"
            android:text="@string/btn_approuver"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

    </RelativeLayout>

</LinearLayout>
